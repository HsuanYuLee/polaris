#!/usr/bin/env bash
# [polaris-git-hooks]
# git push 之前真的被執行的就是這一份。理由與接上的方式見同目錄 pre-commit 的檔頭。
set -euo pipefail
# hook 環境裡有 GIT_DIR，`--show-toplevel` 在那個情況下會回當下的工作目錄而不是 repo 根。
REPO_ROOT="$(env -u GIT_DIR -u GIT_WORK_TREE git rev-parse --show-toplevel)"

# 刪 branch 不帶內容，不必過內容閘。
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == 0000000000000000000000000000000000000000 ]] && exit 0
done || true

bash "$REPO_ROOT/scripts/run-gates.sh" --repo "$REPO_ROOT"

# 範圍照分支算：這條分支相對於預設分支動過的**所有**檔案所屬的那幾支 skill。
#
# 不是「最後一次 commit 動到的」——分支前面幾個 commit 動過、最後一個沒動到的 skill 會整個
# 漏掉，而 2026-08-10 之前這裡連 selftest 都沒有跑，卻有兩處文件寫著「全套留給 push」。
# 也不是每次全套——全套 87.7 秒，掛在每次推送上會被關掉，而一個被關掉的檢查比沒有檢查糟。
bash "$REPO_ROOT/scripts/run-selftests.sh" \
  --repo "$REPO_ROOT" --since-base
