{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/block-git-hook-bypass.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-ship-point.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*(send_message|schedule_message)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-ship-point.sh\""
          }
        ]
      }
    ]
  }
}
